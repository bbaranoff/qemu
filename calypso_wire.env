# calypso_wire.env — PROFIL DE WIRING : un wire par poke (audit 2026-07-25).
# But : remplacer chaque béquille (poke = falsifie une valeur de retour) par le
# vrai signal inter-blocs TSP/TPU/BSP↔DSP. Sourcer APRÈS calypso.env.
# Activer UN wire à la fois (règle : une variable non déterministe à la fois),
# vérifier au log, puis retirer le poke correspondant quand le wire tient.
#
#   POKE (béquille)                WIRE (signal réel)                       vec/cell
#   ----------------------------   --------------------------------------   --------
#   [frame-IT force BSP]           TINT0 cadence le go-live/scheduler       vec20/bit4
#   CALYPSO_BSP_DIRECT_FEED (INT3) direct-feed lève AUSSI BRINT0            vec21/bit5
#   KEEP_IMR/POKE_A4C7/SEED5AC8    soft-vector -> 0xa4c7 (ORM+RSBX natif)   0x3f6d
#   FORCE_0810=0xC000 (abort!)     d_ctrl_system RESUME propre (pas abort)  0x0810 bit3
#   FORCE_DISPATCH/FORCE_DP        ARM poste d_dsp_page chaque frame        API 0x08d4
#   FORCE_3F92                     (drop — suit 0x0810, pas un levier)      —
#   INIT_435B/SEED_52FD            boot seed data[0x435b]=0x52fd (IMR shadow) 0x435b

# --- WIRE 1 : TINT0 (timer DSP) cadence le go-live ------------------------
: "${CALYPSO_TINT0_MASTER:=1}"
: "${CALYPSO_TINT0_PERIOD:=1500}"

# --- WIRE 2 : BSP direct-feed lève BRINT0 (réveil corrélateur) ------------
#   à activer APRÈS avoir validé WIRE 1 seul.
: "${CALYPSO_BSP_DIRECT_BRINT0:=1}"

# --- WIRE 3 : entrée go-live native via l'ORM+RSBX 0xa4c7 -----------------
#   soft-vector data[0x3f6d]=0xa4c7 au lieu de 0xa4df -> RSBX INTM 0xa51b
#   s'exécute -> INTM clear natif -> BRINT0 servi. (levier KEEP_IMR/POKE_A4C7)
: "${CALYPSO_SEED5AC8:=}"
: "${CALYPSO_SEED5AC8_VAL:=0xa4c7}"

# --- WIRE 4 : d_ctrl_system 0x0810 valeur RESUME propre (bit3, PAS bit15) --
#   remplace FORCE_0810=0xC000 (qui met B_TASK_ABORT -> abort). Valeur propre
#   = 0x0008 (b_bcch_freq_ind), abort=0. À basculer quand on retire le poke.
#   (garder FORCE_0810 vide si on teste ce wire)
: "${CALYPSO_FORCE_0810_CLEAN:=}"     # 0x0008 pour activer le poke propre

# --- WIRE 5 : ARM poste d_dsp_page (dispatch natif du scheduler) ----------
: "${CALYPSO_ARM2DSP:=}"              # 1 = bridge task-post ARM->DSP
: "${CALYPSO_ARM2DSP_CONT:=}"

# --- WIRE 6 : boot seed du shadow IMR data[0x435b]=0x52fd -----------------
#   (le seul candidat IMPLEMENT si le boot mask-ROM manque au dump)
: "${CALYPSO_SEED_52FD:=}"

# [2026-07-25] WIRE 3b : IMR tient bit5 (KEEP_IMR fix) mais INTM=1 masque encore
# BRINT0. Clear INTM une fois quand BRINT0 pending -> dispatch correlateur, puis
# self-sustain via RSBX native. Test du verrou INTM.
: "${CALYPSO_FORCE_INTM_ONESHOT:=1}"
