#!/bin/bash
# =============================================================================
#  run.sh — point d'entree UNIQUE de la pile GSM unifiee (Calypso QEMU + Osmocom)
# =============================================================================
#
#  POURQUOI CE FICHIER EST COURT
#  -----------------------------
#  L'ancien run.sh (2426 lignes) melangeait le menu whiptail, la resolution de
#  configuration, le lancement de 20 processus et la mise en page tmux. Un
#  echec au milieu (osmocon absent, BTS sans horloge, mobile jamais demarre)
#  n'apparaissait nulle part : le script continuait. Ici run.sh ne fait plus
#  QUE quatre choses — lire les options, construire un PLAN, l'executer en
#  affichant un etat par etape, et rendre un code de sortie exploitable.
#  Toute la logique metier vit dans run_modules/<NN>-<slug>.sh.
#  L'original est conserve : run.sh.bak_manuel (et les .bak_* anterieurs).
#
#  CHAINE D'APPEL — NE PAS LA CASSER
#  ---------------------------------
#      CALYPSO_SHUNT_LEGIT=1 CALYPSO_SHUNT_NO_CANNED=1 CALYPSO_SHUNT_REAL_FB=1 \
#          ./start-clean.sh
#        -> start-clean.sh : cd $(dirname $0) ; set -a ; . ./calypso.env ; set +a
#        -> exec ./run.sh "$@"
#  calypso.env reste le SEUL point d'injection de configuration ; il est deja
#  source (et exporte) quand run.sh demarre. run.sh ne le relit pas et ne
#  redefinit AUCUNE valeur qui y existe deja.
#
# =============================================================================
#  CONTRAT DE MODULE (normatif)
# =============================================================================
#
#  Un module est un fichier run_modules/NN-<slug>.sh, NN = deux chiffres.
#  Le repertoire run_modules/_lib/ n'est PAS un module (glob [0-9][0-9]-*.sh).
#
#  1. LES MODULES SONT SOURCES, JAMAIS EXECUTES.
#     Raison non negociable : la chaine actuelle repose sur un etat de shell
#     partage qu'un sous-processus ne pourrait pas rendre — PTY_MODEM est
#     extrait du log QEMU puis consomme par osmocon, MACHINE_ARG est construit
#     sur 160 lignes puis consomme au fork, QEMU_PID sert de sonde de vivacite.
#     COROLLAIRE IMPOSE : sourcer un module ne doit produire AUCUN effet de
#     bord. C'est ce qui rend --dry-run reellement inerte.
#
#  2. PARTIE DECLARATIVE (evaluee au source ; effet de bord INTERDIT)
#
#       MOD_REGISTER core-hlr "Base d'abonnes (OsmoHLR)"
#       MOD_DEPS[core-hlr]="core-stp"      # slugs espace-separes ; "" = racine
#       MOD_DEPS_SOFT[core-hlr]=""         # deps ordonnancantes NON bloquantes
#       MOD_REQUIRED[core-hlr]=1           # 1 = FAIL arrete tout ; 0 = [WARN]
#       MOD_PROFILES[core-hlr]="calypso faketrx hybrid core"   # "" = tous
#       MOD_LOG[core-hlr]="$LOGDIR/hlr.log"    # "" = $LOGDIR/mod/<slug>.log
#       MOD_JOURNAL[core-hlr]="osmo-hlr"       # unite systemd, tail sur echec
#       MOD_PURE[core-hlr]=0               # 1 = sans effet de bord -> joue en dry-run
#       MOD_ENABLED_IF[core-hlr]='true'    # expression shell, evaluee A L'EXECUTION
#       MOD_TIMEOUT[core-hlr]=30           # secondes, budget de mod_<p>_wait
#
#     $LOGDIR et $RUN_DIR sont resolus AVANT le source des modules : MOD_LOG[]
#     peut y referer. Aucun autre etat n'est garanti a cet instant.
#
#  3. PARTIE FONCTIONNELLE — prefixe = mod_<slug avec '-' remplace par '_'>_
#     (21-core-hlr.sh -> mod_core_hlr_start). Seul _start est obligatoire.
#
#       mod_<p>_check   prerequis verifiables SANS RIEN LANCER (lecture seule
#                       stricte : -x binaire, -f cfg, variable posee)
#                       rc 0 OK · 1 FAIL · 4 SKIP
#       mod_<p>_status  « est-ce deja demarre ? » (lecture seule)
#                       rc 0 tourne · 1 ne tourne pas · 2 indeterminable
#       mod_<p>_start   lance ; peut supposer check=0 et status=1
#                       rc 0 OK · 1 FAIL · 3 DEJA · 4 SKIP
#       mod_<p>_wait    barriere : bloque jusqu'au critere OBSERVABLE ou timeout
#                       rc 0 OK · 1 FAIL
#       mod_<p>_stop    arret de CE module seul, idempotent — rc 0 toujours
#
#     Le decoupage start/wait est le coeur du gain de diagnostic : il separe
#     « n'a pas demarre » de « a demarre mais n'est jamais devenu pret ».
#
#  4. PROTOCOLE DE MESSAGE — les modules n'ecrivent JAMAIS sur la console.
#     stdout+stderr de check/start/wait/stop partent dans le log du module.
#     Pour parler a l'operateur, quatre helpers qui posent _MOD_REASON :
#         mod_ok                       rc 0
#         mod_fail    "raison actionnable"   rc 1
#         mod_already "raison"               rc 3
#         mod_skip    "raison"               rc 4
#         mod_hint    "action corrective"    ligne supplementaire sous un FAIL
#         mod_say     "..."                  info -> log du module uniquement
#     Une raison vide sur un FAIL est un defaut de module : run.sh l'affiche.
#
#  5. PIDFILE — un module qui lance un processus ecrit le PID DU PROCESSUS
#     FINAL (obtenu par pgrep -f <motif exact> apres la barriere), jamais le
#     $! d'un sous-shell, dans $RUN_DIR/<slug>.pid. C'est ce qui rend status()
#     fiable et interdit l'empilement de processus au relancement.
#
#  6. REMPLACEMENT DE PROCESSUS — un module qui doit finir par un exec (attach
#     tmux) ne l'appelle PAS lui-meme : il remplit le tableau RUN_EXEC_AFTER=()
#     et rend 0. run.sh l'execute apres avoir imprime le resume, sinon le
#     resume serait perdu.
#
#  7. SEQUENCE D'APPEL PAR MODULE (invariable)
#       1. MOD_ENABLED_IF faux ................. [SKIP] desactive
#       2. dependances non satisfaites ......... [SKIP] dependance X
#       3. status() == 0 et pas --force ........ [SKIP] deja demarre
#       4. check() ............................. 1 -> [FAIL] · 4 -> [SKIP]
#       5. --dry-run et MOD_PURE != 1 .......... [ -- ] simule
#       6. start() ............................. 1 -> [FAIL] · 3/4 -> [SKIP]
#       7. wait() .............................. 1 -> [FAIL] demarre mais pas pret
#       8. [ OK ]
#
#  CODES DE SORTIE
#       0  sequence complete (des [WARN] sont possibles)
#       1  module OBLIGATOIRE en echec : la sequence est interrompue
#       2  erreur d'usage ou plan invalide (option inconnue, cycle de deps,
#          run_modules/ absent) — RIEN n'a ete lance
#       3  --dry-run : un check() a echoue
# =============================================================================

set -euo pipefail
IFS=$'\n\t'          # IFS sain. Les listes espace-separees passent par _words().

if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo "run.sh : bash 4+ requis (tableaux associatifs)." >&2
    exit 2
fi

SELF="${BASH_SOURCE[0]}"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
RUN_MODULES_DIR="${RUN_MODULES_DIR:-$SELF_DIR/run_modules}"

# LOGDIR et RUN_DIR sont les deux SEULES variables resolues avant le source des
# modules : MOD_LOG[] y refere. Memes valeurs et memes noms qu'avant.
LOGDIR="${CALYPSO_LOGDIR:-/root}"
RUN_DIR="${CALYPSO_RUN_DIR:-/run/osmo-direct}"
LOG_DIR="$LOGDIR"                 # alias historique consomme par start-direct.sh
SESSION="${CALYPSO_TMUX_SESSION:-calypso}"
TMUX_SOCK="${CALYPSO_TMUX_SOCK:-/tmp/calypso_tmux}"
export LOGDIR RUN_DIR LOG_DIR SESSION TMUX_SOCK RUN_MODULES_DIR SELF_DIR

# -----------------------------------------------------------------------------
#  Delegations historiques : ces options remplacent le processus (exec) et ne
#  concernent pas la sequence. Elles restent traitees AVANT tout le reste pour
#  que le comportement soit strictement celui d'avant.
# -----------------------------------------------------------------------------
for _arg in "$@"; do
    case "$_arg" in
        --run-all)
            echo "[run.sh] --run-all : delegating to run-all.sh"
            exec "$SELF_DIR/run-all.sh" "${@:2}" ;;
        --run-all-debug)
            echo "[run.sh] --run-all-debug : delegating to run-all-debug.sh"
            exec "$SELF_DIR/run-all-debug.sh" "${@:2}" ;;
        --select-verdict)
            echo "[run.sh] --select-verdict : delegating to select-verdict.sh"
            exec "$SELF_DIR/select-verdict.sh" "${@:2}" ;;
    esac
done

# -----------------------------------------------------------------------------
#  Etat d'execution (aucun effet de bord ici)
# -----------------------------------------------------------------------------
PROFILE="${CALYPSO_PROFILE:-calypso}"
DRY_RUN=0 VERBOSE=0 FORCE=0 DO_LIST=0 DO_STATUS=0 DO_STOP=0 PRINT_ENV=0
MENU_MODE=0 DEBUG_FULL_MODE=0 GEN_DOC_MODE=0
ONLY_LIST="" SKIP_LIST=""
declare -a RUN_EXEC_AFTER=()

usage() {
    cat <<EOF
Usage: ./run.sh [OPTION]...   (ou ./start-clean.sh [OPTION]... — recommande)

Demarre la pile GSM unifiee comme une sequence d'initialisation : un module
par etape, un etat par ligne. La configuration vient exclusivement de
calypso.env, source par start-clean.sh ; run.sh n'en redefinit rien.

SEQUENCE
  --profile <p>     calypso (defaut) | faketrx | hybrid | core | none
  --only a,b        n'executer que ces modules (les deps ne sont PAS lancees :
                    leur status() est interroge, FAIL si elles sont a l'arret)
  --skip a,b        forcer [SKIP] sur ces modules
  --force           ignorer status() : relancer meme si deja demarre
  --stop            n'appeler que stop(), dans l'ordre INVERSE du plan
  --status          n'appeler que status(), sous forme de tableau

INSPECTION (aucun effet de bord)
  --list            tableau des modules du plan (#, slug, O/O, deps, log)
  --dry-run         joue le plan sans rien lancer ; seuls les modules purs
                    (MOD_PURE=1, uniquement des affectations) sont reellement
                    executes pour que le plan affiche soit exact
  --print-env       execute les modules purs puis dump env|grep ^CALYPSO_|sort
                    — c'est l'outil de comparaison avec un run de reference
  -h, --help        cette aide

DIVERS
  --verbose         tee la sortie des modules sur la console (defaut : log seul)
  --menu            selection interactive whiptail (run_modules/_lib/menu.sh)
  --debug-full      CALYPSO_DEBUG=ALL + gdb pane (single-shot, ~1-2 GB/min)
  --gen-doc-local   force la generation de doc en fin de sequence
  --run-all | --run-all-debug | --select-verdict
                    delegations inchangees vers les scripts du meme nom

CODES DE SORTIE
  0 sequence complete  ·  1 module obligatoire en echec  ·  2 usage/plan
  3 --dry-run avec un check() en echec

FICHIERS
  modules   $RUN_MODULES_DIR/[0-9][0-9]-*.sh
  logs      \$LOGDIR = $LOGDIR   (un log par module sous \$LOGDIR/mod/)
  sequence  $LOGDIR/run-sequence.log
  pidfiles  \$RUN_DIR = $RUN_DIR
  attach    tmux -S $TMUX_SOCK attach -t $SESSION
EOF
}

# --help est PUR : l'ancien run.sh effacait /dev/shm/calypso_kc a la ligne 2,
# avant meme le parsing, donc --help detruisait un etat. Le rm a migre dans
# mod_teardown_start, la ou il a un sens.
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)      usage; exit 0 ;;
        --list)         DO_LIST=1 ;;
        --dry-run)      DRY_RUN=1 ;;
        --print-env)    PRINT_ENV=1; DRY_RUN=1 ;;
        --status)       DO_STATUS=1 ;;
        --stop)         DO_STOP=1 ;;
        --verbose|-v)   VERBOSE=1 ;;
        --force)        FORCE=1 ;;
        --menu)         MENU_MODE=1 ;;
        --debug-full)   DEBUG_FULL_MODE=1 ;;
        --gen-doc-local) GEN_DOC_MODE=1 ;;
        --profile)      [ $# -ge 2 ] || { echo "run.sh : --profile attend une valeur" >&2; exit 2; }
                        PROFILE="$2"; shift ;;
        --profile=*)    PROFILE="${1#*=}" ;;
        --only)         [ $# -ge 2 ] || { echo "run.sh : --only attend une liste" >&2; exit 2; }
                        ONLY_LIST="$ONLY_LIST,$2"; shift ;;
        --only=*)       ONLY_LIST="$ONLY_LIST,${1#*=}" ;;
        --skip)         [ $# -ge 2 ] || { echo "run.sh : --skip attend une liste" >&2; exit 2; }
                        SKIP_LIST="$SKIP_LIST,$2"; shift ;;
        --skip=*)       SKIP_LIST="$SKIP_LIST,${1#*=}" ;;
        # Branche *) obligatoire : l'ancien case n'en avait pas, une faute de
        # frappe partait silencieusement dans le vide et la pile demarrait
        # avec une configuration differente de celle demandee.
        *)              echo "run.sh : option inconnue « $1 »" >&2
                        echo "         ./run.sh --help" >&2
                        exit 2 ;;
    esac
    shift
done

case "$PROFILE" in
    calypso|faketrx|hybrid|core|none) ;;
    *) echo "run.sh : profil inconnu « $PROFILE » (calypso|faketrx|hybrid|core|none)" >&2
       exit 2 ;;
esac

# --debug-full / --gen-doc-local : memes effets qu'avant, poses ici parce que
# ce sont des overrides d'env, pas des etapes de sequence.
if [ "$DEBUG_FULL_MODE" = 1 ]; then
    export CALYPSO_ICOUNT="${CALYPSO_ICOUNT:-off}"
    export CALYPSO_L2_CLIENT="${CALYPSO_L2_CLIENT:-mobile}"
    export CALYPSO_DEBUG="${CALYPSO_DEBUG:-ALL}"
    export CALYPSO_IRDA_PEER=1
    export CALYPSO_SKIP_GDB_PANE=0
    export CALYPSO_AUTO_GEN_DOC=0
fi
[ "$GEN_DOC_MODE" = 1 ] && export CALYPSO_AUTO_GEN_DOC=1

# -----------------------------------------------------------------------------
#  Bibliotheques. Chacune est optionnelle : run.sh embarque des implementations
#  de repli equivalentes plus bas, ce qui garantit qu'un run_modules/ partiel
#  ne casse pas le demarrage. Quand _lib/ est present, il gagne.
# -----------------------------------------------------------------------------
if [ ! -d "$RUN_MODULES_DIR" ]; then
    echo "run.sh : repertoire de modules introuvable : $RUN_MODULES_DIR" >&2
    echo "         la logique de demarrage y vit desormais (cf. l'en-tete)." >&2
    echo "         repli immediat : $SELF_DIR/run.sh.bak_manuel" >&2
    exit 2
fi
for _lib in ui mod wait proc; do
    # shellcheck source=/dev/null
    [ -r "$RUN_MODULES_DIR/_lib/$_lib.sh" ] && . "$RUN_MODULES_DIR/_lib/$_lib.sh"
done

# -----------------------------------------------------------------------------
#  Registre. declare -A est idempotent : si _lib/mod.sh a deja declare ces
#  tableaux, cette ligne ne les vide pas ; si _lib est absent, elle les cree.
# -----------------------------------------------------------------------------
declare -A MOD_DESC MOD_DEPS MOD_DEPS_SOFT MOD_REQUIRED MOD_PROFILES 2>/dev/null || true
declare -A MOD_LOG MOD_JOURNAL MOD_PURE MOD_ENABLED_IF MOD_TIMEOUT 2>/dev/null || true
declare -A MOD_FILE MOD_ORDER MOD_PREFIX MOD_RESULT MOD_DURMS MOD_REASON 2>/dev/null || true
declare -a MOD_ALL=()

_MOD_REASON=""
_MOD_HINT=""

if ! declare -F MOD_REGISTER >/dev/null 2>&1; then
    # Enregistrement d'un module. Pose des defauts sur TOUS les champs pour que
    # le moteur n'ait jamais a tester l'existence d'une cle (set -u).
    MOD_REGISTER() {
        local slug="$1" desc="${2:-$1}"
        MOD_ALL+=("$slug")
        MOD_DESC["$slug"]="$desc"
        MOD_DEPS["$slug"]=""
        MOD_DEPS_SOFT["$slug"]=""
        MOD_REQUIRED["$slug"]=1
        MOD_PROFILES["$slug"]=""
        MOD_LOG["$slug"]=""
        MOD_JOURNAL["$slug"]=""
        MOD_PURE["$slug"]=0
        MOD_ENABLED_IF["$slug"]="true"
        MOD_TIMEOUT["$slug"]=30
        MOD_FILE["$slug"]="${_MOD_SOURCING_FILE:-?}"
        MOD_ORDER["$slug"]="${_MOD_SOURCING_ORDER:-99}"
        MOD_PREFIX["$slug"]="mod_${slug//-/_}_"
    }
fi
declare -F mod_ok    >/dev/null 2>&1 || mod_ok()      { _MOD_REASON="${1:-}"; return 0; }
declare -F mod_fail  >/dev/null 2>&1 || mod_fail()    { _MOD_REASON="${1:-}"; return 1; }
declare -F mod_already >/dev/null 2>&1 || mod_already() { _MOD_REASON="${1:-}"; return 3; }
declare -F mod_skip  >/dev/null 2>&1 || mod_skip()    { _MOD_REASON="${1:-}"; return 4; }
declare -F mod_hint  >/dev/null 2>&1 || mod_hint()    { _MOD_HINT="${1:-}"; return 0; }
declare -F mod_say   >/dev/null 2>&1 || mod_say()     { printf '%s\n' "$*"; }

# -----------------------------------------------------------------------------
#  Affichage. Le seul test qui compte est [ -t 1 ] : en TTY on reecrit la ligne
#  « [ .. ] » en place, sinon on imprime deux lignes — un log redirige ou un
#  pipe ne doit jamais contenir de \r.
# -----------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_OK=$'\033[32m'; C_FAIL=$'\033[31m'; C_WARN=$'\033[33m'; C_DIM=$'\033[2m'; C_Z=$'\033[0m'
else
    C_OK="" C_FAIL="" C_WARN="" C_DIM="" C_Z=""
fi
_COLS="${COLUMNS:-}"
[ -n "$_COLS" ] || _COLS="$( { tput cols; } 2>/dev/null || echo 100 )"
[ "$_COLS" -gt 0 ] 2>/dev/null || _COLS=100
SHOW_DUR=1; [ "$_COLS" -lt 72 ] && SHOW_DUR=0

SEQ_LOG="$LOGDIR/run-sequence.log"

_trunc() {  # $1=texte $2=largeur — troncature avec ellipse, gabarit colonne 8-59
    local s="$1" w="${2:-52}"
    if [ "${#s}" -le "$w" ]; then printf '%s' "$s"
    else printf '%s…' "${s:0:$((w-1))}"; fi
}
_now_ms() {
    if [ -n "${EPOCHREALTIME:-}" ]; then
        local t="${EPOCHREALTIME/[.,]/}"; echo $(( 10#$t / 1000 ))
    else
        echo $(( $(date +%s) * 1000 ))
    fi
}
_fmt_dur() {  # ms -> "  12.3s" sans printf %f (locale FR = virgule decimale)
    local ms="$1"
    printf '%3d.%01ds' $(( ms / 1000 )) $(( (ms % 1000) / 100 ))
}
_seq_log() {  # journal horodate de la sequence ; muet en dry-run (inertie)
    [ "$DRY_RUN" = 1 ] && return 0
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$SEQ_LOG" 2>/dev/null || true
}
declare -F line_begin >/dev/null 2>&1 || line_begin() {
    if [ -t 1 ]; then printf '\r[ .. ] %-52s' "$(_trunc "$1")"
    else             printf '[ .. ] %s\n' "$1"; fi
}
declare -F line_end >/dev/null 2>&1 || line_end() {  # $1=etat $2=libelle $3=ms
    local col="" cr=""
    case "$1" in
        "[ OK ]") col="$C_OK" ;; "[FAIL]") col="$C_FAIL" ;;
        "[SKIP]"|"[WARN]") col="$C_WARN" ;; *) col="$C_DIM" ;;
    esac
    # Le \r n'existe qu'en TTY : hors TTY il rendrait le fichier de log ou le
    # pipe illisible (exigence de sortie redirigee propre).
    [ -t 1 ] && cr=$'\r'
    if [ "$SHOW_DUR" = 1 ]; then
        printf '%s%s%s%s %-52s %s\n' "$cr" "$col" "$1" "$C_Z" "$(_trunc "$2")" "$(_fmt_dur "${3:-0}")"
    else
        printf '%s%s%s%s %s\n' "$cr" "$col" "$1" "$C_Z" "$(_trunc "$2")"
    fi
    _seq_log "$1 $2 $(_fmt_dur "${3:-0}")"
}
_detail() {  # ligne de detail sous un etat (raison, log, action)
    printf '       %s %s\n' "↳" "$*"
    _seq_log "       $*"
}

# _words : IFS=$'\n\t' n'eclate pas sur l'espace ; les listes de dependances le
# sont. Cette fonction est le seul endroit ou l'on retablit l'IFS par defaut.
_words() {
    local IFS=$' \t\n'
    # shellcheck disable=SC2086
    set -- $1
    [ $# -eq 0 ] && return 0
    printf '%s\n' "$@"
}

# -----------------------------------------------------------------------------
#  Decouverte des modules. Le glob EST la definition de « module » : _lib/ en
#  est exclu par construction, il n'est donc jamais planifie.
# -----------------------------------------------------------------------------
shopt -s nullglob
_found=0
for _mf in "$RUN_MODULES_DIR"/[0-9][0-9]-*.sh; do
    _base="$(basename "$_mf")"
    _MOD_SOURCING_FILE="$_mf"
    _MOD_SOURCING_ORDER="${_base:0:2}"
    # shellcheck source=/dev/null
    . "$_mf"
    _found=$(( _found + 1 ))
done
shopt -u nullglob
unset _MOD_SOURCING_FILE _MOD_SOURCING_ORDER
# Filet : si _lib/mod.sh fournit un MOD_REGISTER qui ne nourrit pas MOD_ALL, on
# reconstruit la liste depuis les cles enregistrees plutot que de rendre un
# « plan vide » incomprehensible.
if [ "${#MOD_ALL[@]}" -eq 0 ] && [ "${#MOD_DESC[@]}" -gt 0 ]; then
    while IFS= read -r _k; do MOD_ALL+=("$_k"); done \
        < <(printf '%s\n' "${!MOD_DESC[@]}" | sort)
fi
if [ "$_found" -eq 0 ]; then
    echo "run.sh : aucun module dans $RUN_MODULES_DIR (attendu : NN-slug.sh)" >&2
    echo "         repli immediat : $SELF_DIR/run.sh.bak_manuel" >&2
    exit 2
fi

_known() { local s; for s in "${MOD_ALL[@]}"; do [ "$s" = "$1" ] && return 0; done; return 1; }
_in_csv() {  # $1=slug $2=liste csv
    local IFS=,; local x
    for x in $2; do [ "$x" = "$1" ] && return 0; done
    return 1
}
for _s in $(printf '%s' "$ONLY_LIST$SKIP_LIST" | tr ',' '\n' | grep -v '^$' || true); do
    _known "$_s" || { echo "run.sh : module inconnu « $_s » (voir ./run.sh --list)" >&2; exit 2; }
done

# -----------------------------------------------------------------------------
#  PLAN : filtre profil / --only / --skip, puis tri topologique sur MOD_DEPS.
#  Tout se joue AVANT le moindre effet de bord : un cycle sort en code 2 sans
#  que rien n'ait ete lance.
# -----------------------------------------------------------------------------
declare -a SELECTED=()
for _s in "${MOD_ALL[@]}"; do
    if [ -n "$ONLY_LIST" ]; then
        _in_csv "$_s" "$ONLY_LIST" || continue
    else
        # MOD_PROFILES vide = module de tous les profils. --profile none ne
        # selectionne rien par profil : il s'emploie avec --only.
        _p="${MOD_PROFILES[$_s]:-}"
        if [ -n "$_p" ]; then
            _hit=0
            for _q in $(_words "$_p"); do [ "$_q" = "$PROFILE" ] && _hit=1; done
            [ "$_hit" = 1 ] || continue
        elif [ "$PROFILE" = none ]; then
            continue
        fi
    fi
    SELECTED+=("$_s")
done
if [ "${#SELECTED[@]}" -eq 0 ]; then
    echo "run.sh : plan vide (profil=$PROFILE${ONLY_LIST:+, --only$ONLY_LIST})" >&2
    exit 2
fi

# Tri topologique de Kahn. Depart : cle (MOD_ORDER, slug) — le prefixe NN ne
# fait que departager des modules independants, l'ordre vrai vient des deps.
_is_selected() { local s; for s in "${SELECTED[@]}"; do [ "$s" = "$1" ] && return 0; done; return 1; }
declare -A _indeg=()
declare -A _emitted=()
for _s in "${SELECTED[@]}"; do
    _n=0
    for _d in $(_words "${MOD_DEPS[$_s]:-} ${MOD_DEPS_SOFT[$_s]:-}"); do
        _is_selected "$_d" && _n=$(( _n + 1 ))
    done
    _indeg["$_s"]=$_n
done
declare -a PLAN=()
while [ "${#PLAN[@]}" -lt "${#SELECTED[@]}" ]; do
    _pick=""
    for _s in $(for x in "${SELECTED[@]}"; do printf '%s %s\n' "${MOD_ORDER[$x]:-99}" "$x"; done | sort -k1,1 -k2,2 | cut -d' ' -f2); do
        [ -n "${_emitted[$_s]:-}" ] && continue
        [ "${_indeg[$_s]}" -eq 0 ] || continue
        _pick="$_s"; break
    done
    if [ -z "$_pick" ]; then
        echo "run.sh : plan invalide — cycle de dependances entre :" >&2
        for _s in "${SELECTED[@]}"; do
            [ -n "${_emitted[$_s]:-}" ] || echo "           $_s -> ${MOD_DEPS[$_s]:-}" >&2
        done
        echo "         rien n'a ete lance." >&2
        exit 2
    fi
    PLAN+=("$_pick"); _emitted["$_pick"]=1
    for _s in "${SELECTED[@]}"; do
        [ -n "${_emitted[$_s]:-}" ] && continue
        for _d in $(_words "${MOD_DEPS[$_s]:-} ${MOD_DEPS_SOFT[$_s]:-}"); do
            [ "$_d" = "$_pick" ] && _indeg["$_s"]=$(( _indeg[$_s] - 1 ))
        done
    done
done

_logfile() {  # chemin de log effectif du module $1
    local s="$1" f="${MOD_LOG[$s]:-}"
    [ -n "$f" ] || f="$LOGDIR/mod/$s.log"
    printf '%s' "$f"
}

# -----------------------------------------------------------------------------
#  --list : tableau du plan, aucun effet de bord.
# -----------------------------------------------------------------------------
if [ "$DO_LIST" = 1 ]; then
    printf '%-4s %-14s %-4s %-5s %-22s %s\n' "#" "MODULE" "OBL" "PUR" "DEPENDANCES" "LIBELLE"
    printf '%s\n' "-------------------------------------------------------------------------------"
    for _s in "${PLAN[@]}"; do
        printf '%-4s %-14s %-4s %-5s %-22s %s\n' \
            "${MOD_ORDER[$_s]:-99}" "$_s" \
            "$([ "${MOD_REQUIRED[$_s]:-1}" = 1 ] && echo OBL || echo opt)" \
            "$([ "${MOD_PURE[$_s]:-0}" = 1 ] && echo pur || echo '-')" \
            "${MOD_DEPS[$_s]:--}" "${MOD_DESC[$_s]:-}"
    done
    printf '%s\n' "-------------------------------------------------------------------------------"
    printf '  profil=%s  %d module(s)  modules=%s  logs=%s\n' \
        "$PROFILE" "${#PLAN[@]}" "$RUN_MODULES_DIR" "$LOGDIR"
    exit 0
fi

# -----------------------------------------------------------------------------
#  Invocation d'une fonction de module. La fonction tourne dans le shell
#  COURANT (cf. contrat §1) : sa sortie est redirigee, jamais pipee — un pipe
#  la placerait dans un sous-shell et PTY_MODEM/MACHINE_ARG seraient perdus.
# -----------------------------------------------------------------------------
_prefix() { printf '%s' "${MOD_PREFIX[$1]:-mod_${1//-/_}_}"; }
_call() {  # $1=slug $2=suffixe(check|status|start|wait|stop) ; rc = rc du module
    local slug="$1" fn rc=0 log
    fn="$(_prefix "$1")$2"
    declare -F "$fn" >/dev/null 2>&1 || return 200      # 200 = fonction absente
    _MOD_REASON=""; _MOD_HINT=""
    log="$(_logfile "$slug")"
    if [ "$DRY_RUN" = 1 ]; then
        # Inertie stricte : ni mkdir, ni fichier de log cree.
        "$fn" >/dev/null 2>&1 || rc=$?
    elif [ "$VERBOSE" = 1 ]; then
        mkdir -p "$(dirname "$log")" 2>/dev/null || true
        exec 9>&1
        "$fn" > >(tee -a "$log" >&9) 2>&1 || rc=$?
        exec 9>&-
    else
        mkdir -p "$(dirname "$log")" 2>/dev/null || true
        "$fn" >>"$log" 2>&1 || rc=$?
    fi
    return "$rc"
}

_dep_ok() {  # une dependance est satisfaite si elle a tourne, ou tournait deja
    case "${MOD_RESULT[$1]:-}" in ok|already|warn|dry) return 0 ;; esac
    return 1
}

# -----------------------------------------------------------------------------
#  --status / --stop : deux parcours degenerés du meme plan.
# -----------------------------------------------------------------------------
if [ "$DO_STATUS" = 1 ]; then
    _rc=0
    for _s in "${PLAN[@]}"; do
        _r=0; _call "$_s" status || _r=$?
        case "$_r" in
            0)   line_end "[ OK ]" "${MOD_DESC[$_s]:-$_s}" 0 ;;
            200) line_end "[ -- ]" "${MOD_DESC[$_s]:-$_s} (pas de sonde)" 0 ;;
            2)   line_end "[WARN]" "${MOD_DESC[$_s]:-$_s} (indeterminable)" 0 ;;
            *)   line_end "[FAIL]" "${MOD_DESC[$_s]:-$_s} (arrete)" 0; _rc=1 ;;
        esac
    done
    exit "$_rc"
fi

if [ "$DO_STOP" = 1 ]; then
    # Ordre INVERSE du plan : on eteint les consommateurs avant les producteurs.
    # Chaque module ne tue QUE son processus : plus de killall/tmux kill-server,
    # qui frappaient aussi les processus de l'autre pile (start-direct.sh).
    for (( _i=${#PLAN[@]}-1 ; _i>=0 ; _i-- )); do
        _s="${PLAN[$_i]}"
        declare -F "$(_prefix "$_s")stop" >/dev/null 2>&1 || continue
        line_begin "Arret : ${MOD_DESC[$_s]:-$_s}"
        _t0="$(_now_ms)"; _call "$_s" stop || true
        line_end "[ OK ]" "Arret : ${MOD_DESC[$_s]:-$_s}" $(( $(_now_ms) - _t0 ))
    done
    exit 0
fi

# -----------------------------------------------------------------------------
#  --menu : le menu whiptail (654 lignes) vit dans _lib/menu.sh et n'est source
#  que la. Il n'a rien a faire dans le chemin de demarrage normal.
# -----------------------------------------------------------------------------
if [ "$MENU_MODE" = 1 ]; then
    if [ -r "$RUN_MODULES_DIR/_lib/menu.sh" ]; then
        # shellcheck source=/dev/null
        . "$RUN_MODULES_DIR/_lib/menu.sh"
    else
        echo "run.sh : --menu indisponible ($RUN_MODULES_DIR/_lib/menu.sh absent)" >&2
        exit 2
    fi
fi

# --print-env doit rendre un stdout EXPLOITABLE PAR diff : toute la sequence
# part sur stderr, seul le dump d'env restera sur stdout (fd 3 mis de cote).
[ "$PRINT_ENV" = 1 ] && exec 3>&1 1>&2

# -----------------------------------------------------------------------------
#  En-tete de sequence
# -----------------------------------------------------------------------------
_env_profile="natif"
[ "${CALYPSO_SHUNT_LEGIT:-0}" = 1 ]    && _env_profile="shunt-legit"
[ "${CALYPSO_SHUNT_NO_LEGIT:-0}" = 1 ] && _env_profile="shunt-no-legit"
[ "${CALYPSO_HACK:-0}" = 1 ]           && _env_profile="hack"
_bar="════════════════════════════════════════════════════════════════════"
printf '%s\n' "$_bar"
printf '  Pile GSM unifiee   profil=%s   mode=%s   env=%s%s\n' \
    "$PROFILE" "${CALYPSO_MODE:-full-grgsm}" "$_env_profile" \
    "$([ "$DRY_RUN" = 1 ] && echo '   [DRY-RUN]' || true)"
printf '  qemu-src=%s   logs=%s   seq=%s\n' "$SELF_DIR" "$LOGDIR" "$SEQ_LOG"
printf '%s\n\n' "$_bar"
_seq_log "=== run.sh profil=$PROFILE mode=${CALYPSO_MODE:-?} env=$_env_profile ==="

# Rotation du journal de sequence (meme regle que osmocon.log : on garde 10).
if [ "$DRY_RUN" != 1 ] && [ -s "$SEQ_LOG" ] && \
   [ "$( { stat -c %s "$SEQ_LOG"; } 2>/dev/null || echo 0 )" -gt 1048576 ]; then
    mv "$SEQ_LOG" "$SEQ_LOG.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
    ls -1t "$SEQ_LOG".[0-9]* 2>/dev/null | tail -n +11 | xargs -r rm -f || true
fi

# -----------------------------------------------------------------------------
#  BOUCLE D'EXECUTION — contrat §7
# -----------------------------------------------------------------------------
N_OK=0 N_FAIL=0 N_SKIP=0 N_WARN=0 N_DRY=0 N_NOTRUN=0
ABORT=0 ABORT_SLUG="" EXIT_CODE=0
T0="$(_now_ms)"

for _s in "${PLAN[@]}"; do
    _desc="${MOD_DESC[$_s]:-$_s}"
    _req="${MOD_REQUIRED[$_s]:-1}"
    _pure="${MOD_PURE[$_s]:-0}"
    _log="$(_logfile "$_s")"

    # Onde de choc : apres l'echec d'un module obligatoire on n'execute plus
    # rien, mais on AFFICHE les modules dont la dependance vient de tomber.
    # L'operateur voit la portee du degat au lieu d'un arret sec.
    if [ "$ABORT" = 1 ]; then
        _hit=""
        for _d in $(_words "${MOD_DEPS[$_s]:-}"); do
            case "${MOD_RESULT[$_d]:-}" in fail|notrun|skip) _hit="$_d"; break ;; esac
        done
        if [ -n "$_hit" ]; then
            line_end "[SKIP]" "$_desc" 0
            _detail "dependance « $_hit » non satisfaite"
            MOD_RESULT["$_s"]="skip"; N_SKIP=$(( N_SKIP + 1 ))
        else
            MOD_RESULT["$_s"]="notrun"; N_NOTRUN=$(( N_NOTRUN + 1 ))
        fi
        continue
    fi

    # 1. porte d'activation (evaluee maintenant : les CALYPSO_SKIP_* sont
    #    posees par les modules 02/03, pas au moment du plan)
    _cond="${MOD_ENABLED_IF[$_s]:-true}"
    if ! eval "$_cond" >/dev/null 2>&1; then
        line_end "[SKIP]" "$_desc" 0
        _detail "desactive par : $_cond"
        MOD_RESULT["$_s"]="skip"; N_SKIP=$(( N_SKIP + 1 )); continue
    fi

    # 2. dependances
    _missing=""
    for _d in $(_words "${MOD_DEPS[$_s]:-}"); do
        if _is_selected "$_d"; then
            _dep_ok "$_d" || _missing="$_d"
        elif [ -n "$ONLY_LIST" ]; then
            # --only ne lance pas les deps : on interroge leur etat reel.
            _r=0; _call "$_d" status || _r=$?
            [ "$_r" = 0 ] || _missing="$_d (hors plan, a l'arret)"
        fi
        [ -n "$_missing" ] && break
    done
    if [ -n "$_missing" ]; then
        line_end "[SKIP]" "$_desc" 0
        _detail "dependance « $_missing » non satisfaite"
        MOD_RESULT["$_s"]="skip"; N_SKIP=$(( N_SKIP + 1 )); continue
    fi

    # --skip explicite (place APRES les deps pour que l'onde de choc soit juste)
    if [ -n "$SKIP_LIST" ] && _in_csv "$_s" "$SKIP_LIST"; then
        line_end "[SKIP]" "$_desc" 0
        _detail "demande par --skip"
        MOD_RESULT["$_s"]="skip"; N_SKIP=$(( N_SKIP + 1 )); continue
    fi

    _t0="$(_now_ms)"
    line_begin "$_desc"

    # 3. deja demarre ? (idempotence : jamais de second lancement sans --force)
    if [ "$FORCE" != 1 ]; then
        _r=0; _call "$_s" status || _r=$?
        if [ "$_r" = 0 ]; then
            line_end "[SKIP]" "$_desc" $(( $(_now_ms) - _t0 ))
            _detail "deja demarre${_MOD_REASON:+ : $_MOD_REASON} — rien fait"
            _detail "pour relancer : ./run.sh --only $_s --force"
            MOD_RESULT["$_s"]="already"; N_SKIP=$(( N_SKIP + 1 )); continue
        fi
    fi

    # 4. prerequis
    _r=0; _call "$_s" check || _r=$?
    if [ "$_r" = 1 ] || [ "$_r" = 4 ]; then
        _dur=$(( $(_now_ms) - _t0 ))
        if [ "$_r" = 4 ]; then
            line_end "[SKIP]" "$_desc" "$_dur"
            _detail "${_MOD_REASON:-prerequis non applicable}"
            [ -n "$_MOD_HINT" ] && _detail "action : $_MOD_HINT"
            MOD_RESULT["$_s"]="skip"; N_SKIP=$(( N_SKIP + 1 )); continue
        fi
        line_end "[FAIL]" "$_desc" "$_dur"
        _detail "prerequis : ${_MOD_REASON:-raison non fournie par le module}"
        [ -n "$_MOD_HINT" ] && _detail "action : $_MOD_HINT"
        MOD_RESULT["$_s"]="fail"; N_FAIL=$(( N_FAIL + 1 ))
        if [ "$DRY_RUN" = 1 ]; then EXIT_CODE=3; continue; fi
        if [ "$_req" = 1 ]; then ABORT=1; ABORT_SLUG="$_s"; EXIT_CODE=1; fi
        continue
    fi

    # 5. dry-run : seuls les modules purs (aucun effet de bord par contrat)
    #    sont reellement joues, pour que le plan et l'env affiches soient exacts.
    if [ "$DRY_RUN" = 1 ] && [ "$_pure" != 1 ]; then
        line_end "[ -- ]" "$_desc [simule]" 0
        MOD_RESULT["$_s"]="dry"; N_DRY=$(( N_DRY + 1 )); continue
    fi

    # 6. lancement
    _r=0; _call "$_s" start || _r=$?
    if [ "$_r" = 200 ]; then
        line_end "[FAIL]" "$_desc" $(( $(_now_ms) - _t0 ))
        _detail "module incomplet : $(_prefix "$_s")start absente (${MOD_FILE[$_s]:-?})"
        MOD_RESULT["$_s"]="fail"; N_FAIL=$(( N_FAIL + 1 ))
        ABORT=1; ABORT_SLUG="$_s"; EXIT_CODE=1; continue
    fi
    if [ "$_r" = 3 ] || [ "$_r" = 4 ]; then
        line_end "[SKIP]" "$_desc" $(( $(_now_ms) - _t0 ))
        _detail "${_MOD_REASON:-rien a faire}"
        MOD_RESULT["$_s"]="$([ "$_r" = 3 ] && echo already || echo skip)"
        N_SKIP=$(( N_SKIP + 1 )); continue
    fi
    if [ "$_r" != 0 ]; then
        _fail_stage="lancement"
    else
        # 7. barriere : « demarre » ne vaut pas « pret ». C'est ici que se
        #    joue la difference avec les sleep fixes de l'ancien script.
        _r=0; _call "$_s" wait || _r=$?
        [ "$_r" = 200 ] && _r=0
        _fail_stage="demarre mais pas pret apres ${MOD_TIMEOUT[$_s]:-30}s"
    fi

    _dur=$(( $(_now_ms) - _t0 ))
    if [ "$_r" = 0 ]; then
        line_end "[ OK ]" "$_desc" "$_dur"
        MOD_RESULT["$_s"]="ok"; N_OK=$(( N_OK + 1 )); continue
    fi

    # echec : la sortie doit etre ACTIONNABLE (quoi, pourquoi, quel log, quoi faire)
    if [ "$_req" = 1 ]; then
        line_end "[FAIL]" "$_desc" "$_dur"
    else
        line_end "[WARN]" "$_desc" "$_dur"
    fi
    _detail "raison : $_fail_stage${_MOD_REASON:+ — $_MOD_REASON}"
    [ "${_MOD_REASON:-}" = "" ] && _detail "raison non fournie par le module (${MOD_FILE[$_s]:-?})"
    [ -r "$_log" ] && _detail "log    : $_log"
    [ -n "${MOD_JOURNAL[$_s]:-}" ] && _detail "journal: journalctl -u ${MOD_JOURNAL[$_s]} -n 50"
    [ -n "$_MOD_HINT" ] && _detail "action : $_MOD_HINT"
    _detail "relance: ./run.sh --only $_s --force --verbose"
    if [ -r "$_log" ]; then
        printf '       %s\n' "─── 15 dernieres lignes de $_log ───"
        tail -n 15 "$_log" 2>/dev/null | sed 's/^/       /' || true
        printf '       %s\n' "──────────────────────────────────────"
    fi
    if [ "$_req" = 1 ]; then
        MOD_RESULT["$_s"]="fail"; N_FAIL=$(( N_FAIL + 1 ))
        ABORT=1; ABORT_SLUG="$_s"; EXIT_CODE=1
    else
        # Module optionnel : la sequence continue, le code de sortie reste 0.
        MOD_RESULT["$_s"]="warn"; N_WARN=$(( N_WARN + 1 ))
    fi
done

TOTAL_MS=$(( $(_now_ms) - T0 ))

# -----------------------------------------------------------------------------
#  --print-env : l'outil d'acceptation. Les modules purs ont tourne, l'env est
#  donc exactement celui que QEMU recevrait. Meme idiome de re-export que
#  l'ancien run.sh, pour que les variables posees sans export soient ramassees.
# -----------------------------------------------------------------------------
if [ "$PRINT_ENV" = 1 ]; then
    while IFS= read -r _v; do export "${_v?}"; done < <(compgen -v | grep '^CALYPSO_' || true)
    exec 1>&3 3>&-          # on rend stdout : a partir d'ici, uniquement l'env
    env | grep '^CALYPSO_' | sort
    exit 0
fi

# -----------------------------------------------------------------------------
#  Resume
# -----------------------------------------------------------------------------
_sep="────────────────────────────────────────────────────────────────────"
printf '\n%s\n' "$_sep"
if [ "$ABORT" = 1 ]; then
    printf '  Sequence interrompue : module OBLIGATOIRE « %s » en echec.\n' "$ABORT_SLUG"
fi
printf '  %d OK · %d SKIP · %d WARN · %d FAIL' "$N_OK" "$N_SKIP" "$N_WARN" "$N_FAIL"
[ "$N_DRY"    -gt 0 ] && printf ' · %d simules' "$N_DRY"
[ "$N_NOTRUN" -gt 0 ] && printf ' · %d non executes' "$N_NOTRUN"
printf '          total %s\n' "$(_fmt_dur "$TOTAL_MS")"
if [ "$DRY_RUN" = 1 ]; then
    printf '  DRY-RUN : aucun processus lance, aucun fichier cree.\n'
elif [ "$ABORT" = 1 ]; then
    printf '  Journal de sequence : %s\n' "$SEQ_LOG"
else
    printf '  tmux -S %s attach -t %s\n' "$TMUX_SOCK" "$SESSION"
fi
printf '%s\n' "$_sep"
_seq_log "=== fin : $N_OK OK / $N_SKIP SKIP / $N_WARN WARN / $N_FAIL FAIL (exit $EXIT_CODE) ==="

# Contrat §6 : un module peut demander un exec final (attach tmux). On ne le
# fait qu'ici, apres le resume — un exec dans le module l'aurait avale.
if [ "$EXIT_CODE" = 0 ] && [ "${#RUN_EXEC_AFTER[@]}" -gt 0 ] && [ "$DRY_RUN" != 1 ]; then
    exec "${RUN_EXEC_AFTER[@]}"
fi
exit "$EXIT_CODE"
